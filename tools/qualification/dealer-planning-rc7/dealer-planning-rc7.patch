@@ -0,0 +1,52 @@
+# plan mission / review action (mirrored from the software-dev contracts).
+# Required top-level fields: schema_version, id, action, mission, steps[]
+# Each step: id, description; optional command, delegates_to{kind, candidates[]},
+# guidance. Contracts are discovered by directory glob over
+# built_in_step_contracts/ and keyed by the internal (mission, action) pair --
+# not by filename and not via a manifest.
+#
+# DIFFERENCE FROM software-dev review: a plan mission has NO work packages, so
+# this contract deliberately omits the software-dev review contract's two
+# WP-specific pieces -- there is NO `gates:` block (no "spec-kitty-pre-review"
+# pre-review handler) and NO `move-task` status_transition. The plan mission is a
+# linear specify -> research -> plan -> review loop advanced with
+# `spec-kitty next`, not a WP board, so review ends by recording the outcome and
+# advancing the loop rather than moving a task to `approved`.
+schema_version: "1.0"
+id: plan-review
+action: review
+mission: plan
+steps:
+  - id: bootstrap
+    description: Load charter context for this action
+    command: "spec-kitty charter context --action review --json"
+
+  - id: verify_plan_fidelity
+    description: Verify the plan honors the spec's intent and stays in sync with spec.md and research.md
+    delegates_to:
+      kind: directive
+      candidates:
+        - DIRECTIVE_010
+        - DIRECTIVE_037
+  - id: assess_intent_and_risk
+    description: Evaluate the plan for intent alignment and risk
+    delegates_to:
+      kind: tactic
+      candidates:
+        - review-intent-and-risk-first
+
+  - id: verify_decisions_complete
+    description: Check that every decision and trade-off is resolved and stopping conditions are met
+    delegates_to:
+      kind: tactic
+      candidates:
+        - quality-gate-verification
+        - stopping-conditions
+
+  - id: record_outcome
+    description: Record the review outcome and advance the mission loop
+    guidance: >
+      A plan mission has no work packages, so there is no task to move to
+      `approved` and no pre-review gate. Advance the loop with
+      `spec-kitty next --result success` when the plan passes, or
+      `spec-kitty next --result blocked` with a reason when it does not.
